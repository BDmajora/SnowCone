#!/bin/sh

# PROVIDE: yetios_snowcone
# REQUIRE: FILESYSTEMS
# BEFORE: NETWORKING DAEMON LOGIN
# KEYWORD: nojail shutdown

. /etc/rc.subr

name="yetios_snowcone"
rcvar="yetios_snowcone_enable"
pidfile="/var/run/${name}.pid"

load_rc_config "$name"
: ${yetios_snowcone_enable:="NO"}

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

snowcone_build="/usr/libexec/yetios/snowcone-build"
snowcone_bin="/tmp/yetios-snowcone/snowcone"
snowcone_fallback="/usr/libexec/yetios/snowcone"

yetios_snowcone_start()
{
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" >/dev/null 2>&1; then
        return 0
    fi

    if [ ! -x "$snowcone_bin" ] && [ -x "$snowcone_build" ]; then
        "$snowcone_build" >/dev/null 2>&1 || true
    fi

    if [ -x "$snowcone_bin" ]; then
        "$snowcone_bin" >/dev/null 2>&1 &
    elif [ -x "$snowcone_fallback" ]; then
        "$snowcone_fallback" >/dev/null 2>&1 &
    else
        return 1
    fi
    echo $! > "$pidfile"
}

yetios_snowcone_stop()
{
    if [ -f "$pidfile" ]; then
        pid="$(cat "$pidfile")"
        kill -TERM "$pid" >/dev/null 2>&1 || true
        i=0
        while kill -0 "$pid" >/dev/null 2>&1 && [ "$i" -lt 2 ]; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" >/dev/null 2>&1; then
            kill -KILL "$pid" >/dev/null 2>&1 || true
        fi
        rm -f "$pidfile"
    fi
    printf '\033[H\033[2J\033[3J' >/dev/ttyv0 2>/dev/null || true
}

yetios_snowcone_status()
{
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" >/dev/null 2>&1; then
        echo "${name} is running as $(cat "$pidfile")."
        return 0
    fi

    echo "${name} is not running."
    return 1
}

run_rc_command "$1"
