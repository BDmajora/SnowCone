#!/bin/sh
#
# PROVIDE: yetios_snowcone
# REQUIRE: root
# BEFORE: FILESYSTEMS
# KEYWORD: nojail shutdown

. /etc/rc.subr

name="yetios_snowcone"
rcvar="yetios_snowcone_enable"
pidfile="/var/run/${name}.pid"
command="/usr/local/sbin/snowcone"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"
extra_commands="status"

load_rc_config "$name"
: ${yetios_snowcone_enable:=NO}

snowcone_pid() {
    if [ -f "$pidfile" ]; then
        read pid < "$pidfile"
        printf '%s' "$pid"
    fi
}

snowcone_running() {
    pid="$(snowcone_pid)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

yetios_snowcone_start() {
    if snowcone_running; then
        return 0
    fi

    if [ ! -x "$command" ]; then
        return 0
    fi

    "$command" >/dev/null 2>&1 &
    echo $! > "$pidfile"
}

yetios_snowcone_stop() {
    if snowcone_running; then
        pid="$(snowcone_pid)"
        kill -TERM "$pid" 2>/dev/null || true
        sleep 1
    fi

    rm -f "$pidfile"

    tty="${SNOWCONE_TTY:-/dev/ttyv0}"
    if [ ! -w "$tty" ]; then
        tty="/dev/console"
    fi
    if [ -w "$tty" ]; then
        printf '\033[0m\033[?25h\033[2J\033[H' > "$tty"
    fi
}

yetios_snowcone_status() {
    if snowcone_running; then
        echo "$name is running as pid $(snowcone_pid)."
        return 0
    fi

    echo "$name is not running."
    return 1
}

run_rc_command "$1"
